      "tags": [
        "insurance",
        "estimating",
        "anthropic",
        "claims"
      ],
      "examples": [
        "Buckled hardwood and sagging ceiling drywall, approx 400 sq ft, Denver CO"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "application/json"
      ]
    }
