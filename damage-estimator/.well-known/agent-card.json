{
  "protocolVersion": "0.3.0",
  "name": "Damage Estimator",
  "description": "Parses contractor quotes and estimates repair cost ranges from a loss description.",
  "url": "https://cruse-sweeney.github.io/agent-cards/damage-estimator/",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
