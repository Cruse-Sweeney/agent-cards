{
  "protocolVersion": "0.3.0",
  "name": "Incident Triage Agent",
  "description": "Classifies production alerts and proposes the matching runbook step.",
  "url": "https://cruse-sweeney.github.io/agent-cards/incident-triage/",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "provider": {
    "organization": "SRE \u2014 Platform",
    "url": "https://cruse-sweeney.github.io/agent-cards"
  },
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "stateTransitionHistory": false
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "classify-alert",
      "name": "Classify an alert",
      "description": "Assigns severity and owning team to an inbound monitoring alert.",
      "tags": [
        "sre",
        "incident",
        "classification",
        "anthropic",
        "platform"
      ],
      "examples": [
        "PagerDuty: claims-api p99 latency 4.2s for 10m"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    },
    {
      "id": "suggest-runbook",
      "name": "Suggest a runbook",
      "description": "Returns the most relevant runbook and the first three steps for an incident.",
      "tags": [
        "sre",
        "incident",
        "runbook",
        "anthropic",
        "platform"
      ],
      "examples": [
        "Elevated 5xx on the policy service"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "text/plain"
      ]
    }
  ]
}
