{
  "protocolVersion": "0.3.0",
  "name": "Fraud Signal Agent",
  "description": "Scores a claim for fraud indicators and explains which signals fired.",
  "url": "https://cruse-sweeney.github.io/agent-cards/fraud-signal/",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "provider": {
    "organization": "Special Investigations \u2014 Claims",
    "url": "https://cruse-sweeney.github.io/agent-cards"
  },
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "stateTransitionHistory": false
