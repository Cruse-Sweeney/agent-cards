  "skills": [
    {
      "id": "score-fraud-risk",
      "name": "Score fraud risk",
      "description": "Returns a 0-100 fraud risk score for a claim record with contributing signals.",
      "tags": [
        "insurance",
        "fraud",
        "risk",
        "scoring",
        "self-hosted",
        "claims"
      ],
      "examples": [
        "{\"policy_id\":\"AU-9920\",\"incident_type\":\"theft\",\"estimated_amount_usd\":41000}"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    },
    {
      "id": "explain-risk-factors",
      "name": "Explain risk factors",
      "description": "Plain-language explanation of why a claim scored the way it did, for an investigator.",
      "tags": [
        "insurance",
        "fraud",
        "explainability",
        "self-hosted",
        "claims"
      ],
      "examples": [
        "Explain the score for claim CLM-2026-0442"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "text/plain"
      ]
    }
  ]
